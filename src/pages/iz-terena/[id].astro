---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqList from '../../components/FaqList.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);

const others = (await getCollection('articles'))
  .filter((a) => a.id !== article.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('sl-SI', { day: 'numeric', month: 'long', year: 'numeric' });

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    inLanguage: 'sl',
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@id': 'https://bton.si/#business' },
    publisher: { '@id': 'https://bton.si/#business' },
    mainEntityOfPage: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Domov', item: 'https://bton.si/' },
      { '@type': 'ListItem', position: 2, name: 'Iz terena', item: 'https://bton.si/iz-terena' },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
    ],
  },
  ...(data.faqs.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<Layout title={data.metaTitle ?? `${data.title} | BTON`} description={data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Header solid />

  <main>
    <section class="guide-hero">
      <div class="container">
        <nav class="guide-crumbs" aria-label="Drobtinice">
          <a href="/">Domov</a>
          <span aria-hidden="true">/</span>
          <a href="/iz-terena">Iz terena</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{data.title}</span>
        </nav>

        <p class="kicker guide-kicker">
          Iz terena · <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        </p>
        <h1 class="guide-title">{data.title}</h1>
        <p class="guide-lead">{data.lead}</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <article class="guide-article">
          <div class="guide-body">
            <Content />
          </div>

          {
            data.faqs.length > 0 && (
              <section class="guide-section">
                <h2 class="guide-section__title">Pogosta vprašanja</h2>
                <FaqList faqs={data.faqs} />
              </section>
            )
          }

          <section class="guide-section guide-cta">
            <h2 class="guide-section__title">Niste prepričani, kaj je prava izbira za vaš prostor?</h2>
            <p>
              Pokličite ali pišite — brezplačno si ogledamo vašo površino,
              svetujemo in pripravimo ponudbo brez obveznosti.
            </p>
            <div class="guide-cta__actions">
              <a href="/#kontakt" class="btn">Naročite brezplačen ogled</a>
              <a href="tel:+38630638685" class="btn btn--ghost btn--bare">+386 30 638 685</a>
            </div>
          </section>

          {
            others.length > 0 && (
              <section class="guide-section">
                <h2 class="guide-section__title">Preberite še</h2>
                <ul class="guide-more">
                  {others.map((a) => (
                    <li>
                      <a href={`/iz-terena/${a.id}`}>{a.data.title}</a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </article>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .guide-hero {
    padding-top: calc(var(--header-h) + var(--space-page-top));
    padding-bottom: var(--space-heading);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .guide-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 1.1rem;
    margin-bottom: var(--space-heading);
    border-bottom: 1px solid var(--line);
  }
  .guide-crumbs a:hover {
    color: var(--accent);
  }
  .guide-crumbs [aria-current] {
    color: var(--ink);
  }

  .guide-kicker {
    margin-bottom: 1.1rem;
  }

  .guide-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    max-width: 22ch;
    text-wrap: balance;
  }

  .guide-lead {
    margin-top: 1.2rem;
    max-width: 62ch;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--body);
  }

  .guide-article {
    max-width: 860px;
  }
  .guide-article p {
    color: var(--body);
    margin-bottom: 1rem;
    max-width: 68ch;
  }
  .guide-article a:not(.btn) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guide-article a:not(.btn):hover {
    color: var(--accent-deep);
  }

  /* Markdown body — rendered content isn't scoped, so target it via :global. */
  .guide-body :global(h2) {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    margin-top: var(--space-heading);
    margin-bottom: 1.1rem;
    padding-top: var(--space-inset);
    border-top: 1px solid var(--line);
  }
  .guide-body > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .guide-body :global(p) {
    color: var(--body);
    margin-bottom: 1rem;
    max-width: 68ch;
  }
  .guide-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guide-body :global(a:hover) {
    color: var(--accent-deep);
  }
  .guide-body :global(strong) {
    color: var(--ink);
  }
  .guide-body :global(ul),
  .guide-body :global(ol) {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-left: 1.4rem;
    margin-bottom: 1rem;
    max-width: 68ch;
    color: var(--body);
  }
  .guide-body :global(ul) {
    list-style: disc;
  }
  .guide-body :global(li::marker) {
    color: var(--accent);
  }

  .guide-body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .guide-body :global(th),
  .guide-body :global(td) {
    min-width: 11rem;
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--line-soft);
    color: var(--body);
  }
  .guide-body :global(thead th) {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  .guide-body :global(tbody td:first-child) {
    min-width: 8rem;
    font-weight: 600;
    color: var(--ink);
  }

  .guide-section {
    margin-top: var(--space-heading);
    padding-top: var(--space-inset);
    border-top: 1px solid var(--line);
  }
  .guide-section__title {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    margin-bottom: 1.1rem;
  }

  .guide-cta__actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .guide-more {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  @media (max-width: 600px) {
    .guide-body :global(th),
    .guide-body :global(td) {
      min-width: 9rem;
    }
    .guide-body :global(tbody td:first-child) {
      min-width: 6.5rem;
    }
  }
</style>
