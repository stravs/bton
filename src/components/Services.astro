---
import { Picture } from 'astro:assets';
import { services } from '../data/services';
---

<section class="section" id="storitve">
  <div class="container">
    <div class="sec-head reveal">
      <div class="sec-head__row">
        <span class="kicker">Storitve</span>
        <span class="kicker">Ogled in ponudba — brezplačno</span>
      </div>
      <h2 class="sec-title">Kateri beton je pravi za vas<em>?</em></h2>
      <p class="sec-lead">
        Vse štiri vrste so iz istega trpežnega betona — razlikujejo se po
        videzu in po tem, kako se površina obnaša pod nogami. Ne veste, katero
        izbrati? Na brezplačnem ogledu vam svetujemo.
      </p>
    </div>

    <div class="svc-grid">
      {
        services.map((s) => (
          <a href={`/storitve/${s.id}`} class="svc-card reveal">
            <span class="svc-card__media">
              <Picture
                src={s.photo}
                alt={s.alt}
                formats={['avif', 'webp']}
                widths={[400, 700, 1000]}
                sizes="(max-width: 760px) 100vw, 50vw"
                quality={58}
                class="svc-card__img"
                loading="lazy"
              />
            </span>
            <span class="svc-card__body">
              <span class="svc-card__head">
                <h3 class="svc-card__title">{s.title}</h3>
                <span class="svc-card__price">{s.price.short}</span>
              </span>
              <p class="svc-card__text">{s.summary}</p>
              <span class="svc-card__tags">
                <span class="svc-card__tags-label">Primerno za:</span>
                {s.idealFor.slice(0, 3).join(', ').toLowerCase()}
              </span>
              <span class="svc-card__more">
                Več o storitvi
                <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true">
                  <path d="M1 6h13M9 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="svc-note reveal">
      Cene so okvirne, na m². Izkop in podlaga iz gramoza nista vključena — če
      ju še nimate urejenih, vas povežemo s preverjenim izvajalcem.
    </p>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    transition: border-color 0.25s ease;
  }

  .svc-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--paper-2);
  }
  .svc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .svc-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .svc-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }

  .svc-card__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    transition: color 0.25s ease;
  }

  .svc-card__price {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .svc-card__text {
    margin-top: 0.8rem;
    color: var(--body);
  }

  .svc-card__tags {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .svc-card__tags-label {
    font-weight: 600;
  }

  .svc-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 1.4rem;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .svc-card__more svg {
    transition: transform 0.3s ease;
  }

  .svc-card:hover {
    border-color: var(--ink);
  }
  .svc-card:hover .svc-card__title {
    color: var(--accent);
  }
  .svc-card:hover .svc-card__more svg {
    transform: translateX(5px);
  }
  .svc-card:hover .svc-card__img {
    transform: scale(1.05);
  }

  .svc-note {
    margin-top: 1.6rem;
    max-width: 70ch;
    font-size: 0.92rem;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
