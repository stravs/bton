---
const steps = [
  {
    title: 'Pokličete ali pišete',
    text: 'Povejte, kaj urejate in približno kako veliko je. Fotografijo prostora lahko pošljete na info@bton.si.',
  },
  {
    title: 'Brezplačen ogled',
    text: 'Pridemo k vam, izmerimo površino in svetujemo, katera obdelava je za vas najboljša.',
  },
  {
    title: 'Ponudba brez obveznosti',
    text: 'Dobite pisno ponudbo s ceno in rokom izvedbe. Odločite se v miru.',
  },
  {
    title: 'Izvedba v nekaj dneh',
    text: 'Delo opravimo hitro in v dogovorjenem roku. Koliko časa traja, je odvisno od velikosti in vrste površine.',
  },
];
---

<section class="section section--tint" id="kako-poteka">
  <div class="container">
    <div class="sec-head reveal">
      <div class="sec-head__row">
        <span class="kicker">Kako poteka</span>
        <span class="kicker">Od klica do nove površine</span>
      </div>
      <h2 class="sec-title">Štirje preprosti koraki<em>.</em></h2>
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="step__num">{i + 1}. korak</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="steps__note reveal">
      <p>
        <strong>Dobro je vedeti:</strong> pred našim začetkom del mora biti teren
        izkopan in utrjen z gramozom. Tega ne delamo sami — če nimate
        izvajalca, vam priporočimo preverjenega.
      </p>
      <a href="#kontakt" class="btn">Naročite brezplačen ogled</a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .step {
    border-top: 2px solid var(--ink);
    padding-top: 1.2rem;
  }

  .step__num {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .step__title {
    font-size: 1.3rem;
    margin-top: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .step__text {
    color: var(--body);
    font-size: 0.97rem;
  }

  .steps__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .steps__note p {
    max-width: 64ch;
    color: var(--body);
  }
  .steps__note strong {
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps__note .btn {
      width: 100%;
    }
  }
</style>
